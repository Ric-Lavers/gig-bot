# Twilio — twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Twilio Sync Service SID — Console → Sync → Create a Service
SYNC_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI — platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Party details — these are injected into the bot's system prompt
PARTY_NAME=The Big One
PARTY_DATE=Saturday June 14th at 9pm
PARTY_VENUE=The Warehouse
PARTY_ADDRESS=123 Main St, Brooklyn NY
PARTY_DJS=DJ Nova and DJ Rave

# Initial invite message — {name} is replaced per guest
INVITE_MESSAGE=Hey {name}! You're invited to {party}. Reply to this number to chat with our bot for details, surprises, and more 👀
